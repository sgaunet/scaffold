name: release

on:
  push:
    # Pattern matched against refs/tags
    tags:
      - '**'

permissions:
  contents: write
  packages: write

jobs:
  goreleaser-release:
    runs-on: docker
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Fully-qualified URL: Forgejo resolves bare action names against its own
      # DEFAULT_ACTIONS_URL, which does not mirror jdx/mise-action.
      - name: Set up tools
        uses: https://github.com/jdx/mise-action@v4
        with:
          install: true
          cache: true

      - name: Create release
        run: task release
        env:
          GITEA_TOKEN: ${{ secrets.CI_TOKEN }}
          GITHUB_TOKEN: ""
          # Your GoReleaser Pro key, if you are using the 'goreleaser-pro' distribution
          # GORELEASER_KEY: ${{ secrets.GORELEASER_KEY }}
