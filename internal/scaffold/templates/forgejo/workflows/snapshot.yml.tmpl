name: snapshot

on:
  pull_request:
  push:

permissions:
  contents: read

jobs:
  goreleaser-snapshot:
    runs-on: docker
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Fully-qualified URL: Forgejo resolves bare action names against its own
      # DEFAULT_ACTIONS_URL, which does not mirror jdx/mise-action.
      - name: Set up tools
        uses: https://github.com/jdx/mise-action@v4
        with:
          install: true
          cache: true

      - name: Create snapshot
        run: task snapshot
        env:
          GITEA_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_TOKEN: ""
          # Your GoReleaser Pro key, if you are using the 'goreleaser-pro' distribution
          # GORELEASER_KEY: ${{ secrets.GORELEASER_KEY }}
