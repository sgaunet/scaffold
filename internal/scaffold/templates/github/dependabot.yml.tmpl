# Go modules are deliberately absent. Dependabot reports every advisory that
# touches the module graph, whether or not the vulnerable code is reachable, and
# that noise crowds out the findings that matter. The Vulnerability Scan
# workflow runs govulncheck instead, which filters by symbol reachability.
# See https://words.filippo.io/dependabot/
version: 2
updates:
[[ if .Docker ]]
  # Docker: base-image bumps are rarely urgent, so monthly is enough.
  - package-ecosystem: docker
    directory: "/"
    schedule:
      interval: monthly
      time: "07:00"
      timezone: Etc/UTC
    open-pull-requests-limit: 5
[[ end ]]
  # GitHub Actions: low priority. Monthly, batched into a single PR, and
  # capped so it never crowds out the Go queue.
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: monthly
      time: "07:00"
      timezone: Etc/UTC
    open-pull-requests-limit: 3
    groups:
      github-actions:
        patterns:
          - "*"
